# =============================================================================
# Client (Vite) — set these on Vercel as Environment Variables
# Never put service-role or webhook secrets in VITE_* variables.
# =============================================================================

# Supabase project URL and anon/publishable key (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Production storefront site URL (canonical SEO, og:image, robots, sitemap)
VITE_SITE_URL=https://ember-oak-beige.vercel.app

# Public app URL for transactional email links (optional; falls back to VITE_SITE_URL)
VITE_APP_URL=https://ember-oak-beige.vercel.app

# Sentry browser DSN (optional). If unset, Sentry does not start.
# On Vercel: set VITE_SENTRY_DSN only. Release uses VERCEL_GIT_COMMIT_SHA and
# environment uses VERCEL_ENV automatically at build time (also mirrored as
# VITE_VERCEL_GIT_COMMIT_SHA / VITE_VERCEL_ENV when injected by Vite define).
VITE_SENTRY_DSN=

# Portfolio / demo on Vercel: set to "true" so /mock-checkout works in production.
# Server still requires PAYMENT_PROVIDER=mock for signing (no real charges).
VITE_DEMO_MODE=true

# Optional: set to "true" to noindex the whole site.
# VITE_DEMO_NOINDEX=true

# =============================================================================
# Supabase Edge Function secrets (names only — set via CLI / Dashboard)
#   npx supabase secrets set NAME=value
#   or: powershell -File scripts/check-setup.ps1
# Auto-provided by Supabase platform (usually already present):
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ANON_KEY,
#   SUPABASE_DB_URL, SUPABASE_JWKS, SUPABASE_PUBLISHABLE_KEYS, SUPABASE_SECRET_KEYS
# =============================================================================
#
# APP_URL                  — storefront origin used in emails / mock redirects
# EMAIL_FROM               — Resend From header, e.g. Ember & Oak <hello@…>
# PAYMENT_PROVIDER         — "mock" for this portfolio demo
# PAYMENT_WEBHOOK_SECRET   — HMAC secret for payment-webhook (mock/prod)
# RESEND_API_KEY           — Resend API key for order/contact email
# STORE_NOTIFY_EMAIL       — inbox for contact-form notifications
# MOCK_WEBHOOK_SECRET      — optional alias; PAYMENT_WEBHOOK_SECRET is preferred
#
