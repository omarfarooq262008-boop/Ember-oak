# Supabase project URL and anon/publishable key (REQUIRED for Vercel deployment)
# NOTE: Never put SUPABASE_SERVICE_ROLE_KEY or any secret in VITE_* variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Production storefront site URL (e.g. https://your-deployment.vercel.app or https://emberandoak.pk)
# Used for canonical SEO tags, og:image URLs, robots.txt, and sitemap.xml
VITE_SITE_URL=https://emberandoak.pk

# Public application URL for transactional email links (optional, falls back to VITE_SITE_URL or window.location.origin)
VITE_APP_URL=https://emberandoak.pk

# Sentry browser DSN (optional). If unset, Sentry does not start and the app runs normally.
# On Vercel: set VITE_SENTRY_DSN only. Release uses VERCEL_GIT_COMMIT_SHA and environment uses VERCEL_ENV automatically at build time.
VITE_SENTRY_DSN=

# Do not put PAYMENT_PROVIDER in VITE_*. The storefront reads paymentProvider from the
# public health Edge Function; mock-sign-payment enforces the real secret server-side.
